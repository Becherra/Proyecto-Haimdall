GEOCODER_USER_AGENT=
# Activa los datos de muestra del frontend mientras el análisis no esté conectado.
NEXT_PUBLIC_USE_MOCKS=false

# Instancia de OpenTopoData (NASA SRTM 30 m) para medir altitud y pendiente. Vacío = la pública (1 consulta por segundo, 1000 al día).
OPENTOPODATA_URL=
